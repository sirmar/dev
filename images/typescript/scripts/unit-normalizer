#!/usr/bin/env node
'use strict'

const fs = require('fs')

const raw = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'))
const failures = []

for (const file of raw.testResults || []) {
  const filePath = file.testFilePath || file.name
  if (!filePath) continue
  const path = filePath.replace(/^\/workspace\//, '')
  for (const t of (file.testResults || file.assertionResults || [])) {
    if (t.status === 'failed') {
      failures.push({ node_id: [path, ...t.ancestorTitles, t.title].join(' > ') })
    }
  }
}

fs.writeFileSync(process.argv[3], JSON.stringify({ passed: failures.length === 0, failures }))
